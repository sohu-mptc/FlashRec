# FlashRec serve knobs.
#
#   cp scripts/serve.env.example scripts/serve.env   # gitignored; then edit
#   bash scripts/serve.sh
#   SERVE_ENV=/path/to/prod.env bash scripts/serve.sh
#
# Production launch is MODEL_PATH + SID_VOCAB_FILE; layout is inferred.
#   MODEL_PATH=/path/to/model SID_VOCAB_FILE=data/catalogs/sid2pid_beamrec_l4.json \
#     bash scripts/serve.sh
#
# Precedence (high → low) when this file uses ${VAR:-...}:
#   1. Environment already set (PORT=9000 bash scripts/serve.sh)
#   2. $SERVE_ENV or scripts/serve.env
#   3. Defaults in this file / scripts/serve.sh / cli.py
#
# Bare VAR=value (no ${VAR:-}) pins the value and overwrites a CLI export.
# This file is sourced as bash: only load a trusted path.
#
# Comment out SID_VOCAB_FILE (or SID_VOCAB_FILE=) for unconstrained smoke.
# SID=START:END/SIZE,... (and the three SID_* split vars) override inference
# if the tokenizer convention does not match.

# --- model (required) -------------------------------------------------------
# MODEL_PATH="${MODEL_PATH:-/path/to/OneRec-1.7B}"

# --- bind / device ----------------------------------------------------------
# No auth. Only set HOST=0.0.0.0 on a trusted network or behind a proxy.
HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-8000}"
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
LOG_LEVEL="${LOG_LEVEL:-info}"

# --- precision --------------------------------------------------------------
# fp8 = W8A8 per-channel online quant. Any other QUANTIZATION value → bf16.
# FP8 mainly saves weight/KV memory; narrow-beam 1.7B is often not faster.
QUANTIZATION="${QUANTIZATION:-fp8}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8_e4m3}"
ATTENTION_BACKEND="${ATTENTION_BACKEND:-flashinfer}"
MEM_FRACTION_STATIC="${MEM_FRACTION_STATIC:-0.8}"

# --- beam / graph / slots ---------------------------------------------------
# cuda-graph-max-bs = captured beam-row batch. batch-slots = admit budget
# (≈ requests × n). If BATCH_SLOTS is unset, serve.sh follows CUDA_GRAPH_MAX_BS.
# Defaults (800) admit one n=512 request per wave. OOM: lower these three,
# MEM_FRACTION_STATIC, or BEAM_WIDTH.
BEAM_WIDTH="${BEAM_WIDTH:-50}"
MAX_TOKENS="${MAX_TOKENS:-5}"
CUDA_GRAPH_MAX_BS="${CUDA_GRAPH_MAX_BS:-800}"
# BATCH_SLOTS="${BATCH_SLOTS:-}"

# --- batching / schedule ----------------------------------------------------
BATCH_WAIT_MS="${BATCH_WAIT_MS:-4}"
BATCH_WAIT_MAX_MS="${BATCH_WAIT_MAX_MS:-10}"
TARGET_BATCH_REQUESTS="${TARGET_BATCH_REQUESTS:-8}"
MAX_BATCH_REQUESTS="${MAX_BATCH_REQUESTS:-16}"
SCHEDULE_POLICY="${SCHEDULE_POLICY:-lpm}"
# 0 = pure LPM (can starve short prompts under radix).
LPM_AGING_MS="${LPM_AGING_MS:-300}"
HOST_WORKER_THREADS="${HOST_WORKER_THREADS:-4}"
# 0 = pipeline off. >=1 is often slower than eager — measure first.
PIPELINE_STAGES="${PIPELINE_STAGES:-0}"

# --- SID trie (production recall) -------------------------------------------
# Relative paths are resolved against the repo root by serve.sh.
SID_VOCAB_FILE="${SID_VOCAB_FILE:-data/catalogs/sid2pid_beamrec_l4.json}"
# Overrides only — leave unset so the tokenizer + catalog infer the layout:
# SID="${SID:-}"
# SID_TOKEN_RANGE="${SID_TOKEN_RANGE:-}"
# SID_CODEBOOK_SIZES="${SID_CODEBOOK_SIZES:-}"
# SID_BOUNDARY_TOKENS="${SID_BOUNDARY_TOKENS:-}"
# SYSTEM_PROMPT_FILE="${SYSTEM_PROMPT_FILE:-}"
# Optional radix-warmup probes: two distinct user texts whose shared prefix
# is pinned. Unset pins chat template + system prompt only.
# WARMUP_USER_A="${WARMUP_USER_A:-}"
# WARMUP_USER_B="${WARMUP_USER_B:-}"

# --- optional flags ---------------------------------------------------------
# Non-empty enables --torch-compile (prefill only).
# TORCH_COMPILE="${TORCH_COMPILE:-1}"
# Appended last; overrides earlier flags on conflict (argparse last-wins).
# Word-split on IFS — do not put quoted spaces inside a single token.
# EXTRA_SERVER_ARGS="${EXTRA_SERVER_ARGS:---disable-radix}"
EXTRA_SERVER_ARGS="${EXTRA_SERVER_ARGS:-}"

# FLASHREC_TORCH_PROFILER_DIR="${FLASHREC_TORCH_PROFILER_DIR:-}"

# --- n=512 / n=1000 recipe (one dominant n per instance) -----------------------
# Do not duplicate the assignments below: ${VAR:-} would keep the 800/50
# values already set above. Change those lines instead:
#   BEAM_WIDTH=512 (or 1000), CUDA_GRAPH_MAX_BS=4096, BATCH_SLOTS=4096,
#   LPM_AGING_MS=150. 4096 slots ≈ 4 concurrent n=1000 requests.
