# Optional local defaults for RecIF benches.
# Copy to `env` (gitignored) and edit:
#   cp benchmark/local/env.example benchmark/local/env

# RecIF packed mappings directory (must contain video/video_test.parquet etc.)
DATA_DIR=benchmark/local/data/benchmark_data

# Single model (used when MODELS is unset):
MODEL_PATH=benchmark/local/models/OneRec-1.7B

# Or run two (or more) checkpoints back-to-back.
# Names are resolved under benchmark/local/models/ unless absolute.
# MODELS="OneRec-1.7B OneRec-0.6B"

# Optional overrides:
# SID_VOCAB_FILE=data/catalogs/sid2pid_beamrec_l4.json
# FLASHREC_GPU=0
# SGL_GPU=1
# SMOKE=1
